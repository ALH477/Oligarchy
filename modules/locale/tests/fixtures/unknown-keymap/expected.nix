  custom.locale = {
    language = "en-US";
    keyboard = {
      # No xkb mapping is known for the vconsole keymap "sun-type6-de-latin1": it
      # is carried over verbatim and keyboard.layout is left at the module
      # default. Set keyboard.layout/variant by hand for X and Wayland.
      consoleKeyMap = "sun-type6-de-latin1";
    };
  };
