{
  description = "oligarchy-forge generated sandbox: {{ project_name }}";

  # Pinned to match the parent Oligarchy repo's channel (see CLAUDE.md).
  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-25.11";
{% for input in extra_flake_inputs %}
  # Declared — and therefore only ever fetched — because an agent selected for
  # this project comes from this flake rather than from nixpkgs. See
  # Agent::flake_input(); a project that selects none of those agents gets a
  # generated flake whose only input is nixpkgs.
  inputs.{{ input.name }}.url = "{{ input.url }}";
{% endfor %}
  outputs = { self, nixpkgs{% for input in extra_flake_inputs %}, {{ input.name }}{% endfor %} }:
    let
      system = "x86_64-linux";
      # Matches the parent Oligarchy flake's own stance (CLAUDE.md: "Unfree
      # allowed; broken is NOT") — needed for real agents in the catalog, e.g. Cursor
      # CLI (nixpkgs marks cursor-cli unfree; refuses to evaluate otherwise).
      pkgs = import nixpkgs { inherit system; config.allowUnfree = true; };
    in
    {
      packages.${system}.default = pkgs.dockerTools.streamLayeredImage {
        name = "{{ image_name }}";
        tag = "latest";
        # usr-bin-env: nixpkgs binaries have no /usr/bin/env by default, but
        # virtually every npm/pip-installed CLI (agent wrappers included)
        # ships a `#!/usr/bin/env node`-style shebang and fails to exec
        # without it. Unconditional, not gated on any extension/agent — any
        # of them could hit this once something installs a global package
        # at runtime.
        contents = with pkgs; [ {{ packages }} ] ++ [ {{ agent_wrappers }} ] ++ [
          (pkgs.runCommand "usr-bin-env" { } ''
            mkdir -p $out/usr/bin
            ln -s ${pkgs.coreutils}/bin/env $out/usr/bin/env
          '')
        ];
        config = {
          Cmd = [ "/bin/bash" ];
          WorkingDir = "/workspace";
          Env = [ "PATH=/bin:/usr/bin" ];
        };
      };
    };
}
