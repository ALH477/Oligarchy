index 0000000..3d93176
--- /dev/null
+++ b/src/testfont.zig
@@ -0,0 +1,31 @@
+//! Test-only helper: open a system font, or skip the test *loudly*.
+//!
+//! The font tests used to `catch return` on a missing file. A bare `return`
+//! from a test body reports as a PASS, so on any machine that does not have
+//! these exact paths installed the suite was green while asserting nothing --
+//! and the paths are distribution-specific, so that is most machines, and any
+//! Arch box without ttf-liberation or ttf-iosevka-term-nerd.
+//!
+//! `error.SkipZigTest` is the Zig idiom for "not run here": the test runner
+//! counts it separately and prints it. A skip that is reported is honest; a
+//! skip that looks like a pass is not.
+const std = @import("std");
+
+pub fn openOrSkip(io: std.Io, path: []const u8) !std.Io.File {
+    return std.Io.Dir.openFileAbsolute(io, path, .{}) catch {
+        std.debug.print("SKIP: font not installed: {s}\n", .{path});
+        return error.SkipZigTest;
+    };
+}
+
+/// Read a whole font file, skipping the test if it is not installed.
+/// A failure *after* a successful open is a real error, not a skip.
+pub fn readOrSkip(io: std.Io, gpa: std.mem.Allocator, path: []const u8) ![]u8 {
+    const file = try openOrSkip(io, path);
+    defer file.close(io);
+    const n = try file.length(io);
+    const bytes = try gpa.alloc(u8, n);
+    errdefer gpa.free(bytes);
+    _ = try file.readPositionalAll(io, bytes, 0);
+    return bytes;
+}
