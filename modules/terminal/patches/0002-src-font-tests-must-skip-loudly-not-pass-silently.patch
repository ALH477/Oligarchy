 src/testfont.zig      | 31 +++++++++++++++++++++++++++++++
 src/type.zig          | 19 ++++++-------------
 src/type/cbdt.zig     |  7 ++-----
 src/type/truetype.zig |  7 ++-----
 5 files changed, 42 insertions(+), 23 deletions(-)
 create mode 100644 src/testfont.zig

