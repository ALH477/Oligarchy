# Secrets management - NEVER commit these
/secrets/
secrets/keys.txt
secrets/secrets.yaml
secrets/README.md
*.age
*.decrypted

# Keep sops.yaml in git (contains only public key, no secrets)
!secrets/.sops.yaml

# Plaintext env secrets must never be committed; sops-encrypted (*.enc.*) may.
modules/secrets/*.env
!modules/secrets/*.enc.env
modules/secrets/keys.txt

# Python bytecode
__pycache__/
*.pyc

# Rust build artifacts
modules/greeting/target/
modules/mcp-servers/target/

# Android/Gradle build artifacts (modules/hypr-controller/android)
modules/hypr-controller/android/.gradle/
modules/hypr-controller/android/build/
modules/hypr-controller/android/app/build/
modules/hypr-controller/android/local.properties
modules/hypr-controller/android/gradle/wrapper/gradle-wrapper.jar
modules/hypr-controller/android/.idea/
*.iml
